{
  "name": "opencode-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resmi olmayan OpenCode eklenti koleksiyonu — tool-compact (DHS PTC-mode) ve build-hooks",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:plugins": "for d in plugins/*; do echo \"build $d\"; done",
    "test": "echo \"no tests yet\" && exit 0",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "tool-compact",
    "build-hooks"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "1.18.21"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
