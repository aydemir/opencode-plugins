{
  "name": "opencode-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resmi olmayan OpenCode eklenti koleksiyonu — opencode-context-saver (opencode-context-saver, DHS PTC-mode) ve opencode-build-tracker (opencode-build-tracker)",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:plugins": "for d in plugins/*; do echo \"build $d\"; done",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-context-saver",
    "opencode-build-tracker",
    "opencode-truncation-noticer",
    "opencode-context-saver",
    "opencode-build-tracker",
    "opencode-truncation-noticer",
    "dhs",
    "ptc",
    "truncation-notice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "1.18.21"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./opencode-build-tracker": "./dist/plugins/opencode-build-tracker.js",
    "./opencode-context-saver": "./dist/plugins/opencode-context-saver.js",
    "./opencode-truncation-noticer": "./dist/plugins/opencode-truncation-noticer.js",
    "./opencode-build-tracker": "./dist/plugins/opencode-build-tracker.js",
    "./opencode-context-saver": "./dist/plugins/opencode-context-saver.js",
    "./opencode-truncation-noticer": "./dist/plugins/opencode-truncation-noticer.js"
  },
  "files": [
    "dist",
    "plugins",
    "docs"
  ]
}
