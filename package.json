{
  "name": "opencode-plugins",
  "version": "0.1.0",
  "type": "module",
  "description": "Resmi olmayan OpenCode eklenti koleksiyonu — opencode-context-saver (DHS PTC-mode), opencode-build-tracker ve opencode-truncation-noticer",
  "repository": {
    "type": "git",
    "url": "https://github.com/aydemir/opencode-plugins.git"
  },
  "workspaces": [
    "plugins/mcp-bash-tools",
    "scripts/cpu-liveness-probe"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:plugins": "tsc --project tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-context-saver",
    "opencode-build-tracker",
    "opencode-truncation-noticer",
    "opencode-context-saver",
    "opencode-build-tracker",
    "opencode-truncation-noticer",
    "dhs",
    "ptc",
    "truncation-notice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "1.18.21"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./server": "./dist/plugins/server.js",
    "./opencode-build-tracker": "./dist/plugins/opencode-build-tracker.js",
    "./opencode-context-saver": "./dist/plugins/opencode-context-saver.js",
    "./opencode-truncation-noticer": "./dist/plugins/opencode-truncation-noticer.js",
    "./opencode-cpu-liveness": "./dist/plugins/opencode-cpu-liveness.js"
  },
  "files": [
    "dist",
    "plugins",
    "docs"
  ]
}
