{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/opencode-context-saver.ts",
    "./plugins/opencode-build-tracker.ts",
    "./plugins/opencode-truncation-noticer.ts"
  ],
  // opencode-context-saver opsiyonel ayarları:
  //   enabled:        false   → tüm prune'ları devre dışı bırakır (debug).
  //   headChars:      100     → her tool çıktısının başından korunacak char.
  //   tailChars:      50      → sonundan korunacak char.
  //   compressThreshold: 500  → bu eşiği aşmayan çıktıya dokunulmaz.
  //   injectAsSummary: true   → tool log özetini chat.message'a enjekte et.
  //   maxLogEntries:  50      → tutulan log entry üst sınırı.
  //   discloseOnce:   true    → oturum başında LLM'e bir kezlik kaçış notu.
  //   alwaysRawCommands: []   → args'ta geçerse ham bırak (substring; "regex:" önekli desen).
  //   disableForCalls: 0      → oturum başına ilk N çağrıyı ham bırak (geçici kapatma).
  //
  // İnline bypass: tool çağrısının gövdesine "#no-prune" yaz → o çağrıya
  // dokunulmaz. Marker'daki "For raw output: no_prune=true (this call)
  // or enabled:false (off)" ipucu LLM'e bu yöntemi hatırlatır.
  "pluginOptions": {
    "opencode-context-saver": {
      "enabled": true,
      "skipWhenContains": "#no-prune",
      "headChars": 100,
      "tailChars": 50,
      "compressThreshold": 500,
      "injectAsSummary": true,
      "maxLogEntries": 50,
      "discloseOnce": true,
      "alwaysRawCommands": [],
      "disableForCalls": 0
    },
    "opencode-truncation-noticer": {
      "enabled": true,
      "watchTools": ["read"],
      "skipWhenContains": "#no-trunc-notice"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    // Kendi server'imiz: once derle (dist/ repoda yok):
    //   npm run build   (veya: bun run build)
    "opencode-mcp-bash-tools": {
      "type": "local",
      "command": ["node", "./dist/plugins/mcp-bash-tools/src/server.js"],
      "enabled": true
    }
  }
}
