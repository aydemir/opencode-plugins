{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-mem",
    "oh-my-openagent",
    "./plugins/tool-compact.ts",
    "./plugins/build-hooks.ts"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  }
}
