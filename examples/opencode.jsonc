{
  "$schema": "https://opencode.ai/config.json",
  // opencode-mem geçici olarak çıkarıldı: Console/Muse Spark Free provider'ı tool_choice="required" desteklemiyor, bkz. https://github.com/tickernelz/opencode-mem/issues - fork'ta fixlenecek
  "plugin": [
    "oh-my-openagent",
    "./plugins/context-saver.ts",
    "./plugins/build-tracker.ts"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  }
}
